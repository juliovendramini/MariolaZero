{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Enviar projeto",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "powershell.exe",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/envia.ps1"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Enviar para o robô (Linux/macOS: envia.sh)",
            "type": "node-terminal",
            "request": "launch",
            "command": "bash envia.sh",
            "cwd": "${workspaceFolder}"
        }
    ]
}